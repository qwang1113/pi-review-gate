#!/usr/bin/env bash
# pi-review-gate defense-in-depth: same gate verification as pre-commit, on push.
# Run the pre-commit hook verbatim (it now validates fingerprint, not just labels).
#
# LANE SPLIT (mirrors lib/constants.ts requiresFullPrecommit): a commit is
# local and reversible, so it is satisfied by the fast precommit lane (lint +
# typecheck + build + the tests related to the changed files). A PUSH publishes
# the work, so it additionally requires a run whose tests were not narrowed.
# REVIEW_GATE_REQUIRE_FULL is how this hook asks pre-commit for that stricter
# check; the extension applies the identical rule at L1.
set -euo pipefail
[[ "${REVIEW_GATE_BYPASS:-}" == "1" ]] && exit 0
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# VERIFIED BRANCHES (2026-09-28): a branch a relocated session finished is
# recorded in the main repo by the tree it was reviewed and accepted at; when
# every pushed tip is such a tree, this checkout's own gate state (another
# session's verdict) is not the question. Anything else falls through.
PUSHED_REFS="$(cat)"
VERIFIED_SCRIPT="${HOOK_DIR}/../scripts/pre-push-verified.cjs"
if [[ -f "$VERIFIED_SCRIPT" ]] && command -v node >/dev/null 2>&1 &&
   printf '%s\n' "$PUSHED_REFS" | node "$VERIFIED_SCRIPT"; then
  echo "[review-gate] push: every pushed branch is a recorded verified tree (.pi/verified-branches.json)." >&2
  exit 0
fi
REVIEW_GATE_REQUIRE_FULL=1 exec "$HOOK_DIR/pre-commit" </dev/null
