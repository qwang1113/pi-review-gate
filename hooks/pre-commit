#!/usr/bin/env bash
# pi-review-gate pre-commit hook — THIN SHELL since 2026-09-08 (goal ②).
#
# The full verdict chain — sidecar shape/bypass, docSync, the L6 test-label
# scan, the staged-divergence check with its fingerprint, and the final
# verdict comparison — runs in ONE node process (scripts/pre-commit-check.cjs)
# exec'd at the bottom. It used to cold-start node four times per commit.
# This shell keeps only what the node process cannot own: environment
# sanitisation, the fail-closed layout guards, and exit-code mapping.
#
# Bypass: REVIEW_GATE_BYPASS=1 git commit ...
set -euo pipefail

[[ "${REVIEW_GATE_BYPASS:-}" == "1" ]] && exit 0

# Sidecar variant (F4): a session an orchestrator spawned owns its OWN sidecar
# (RG_STATE_VARIANT), so the hook must check the file that session actually
# writes. The variable is sanitized here too — the hook never trusts an
# environment string with a path in it. NO variable ⇒ the DEFAULT file, which
# is the fail-closed direction: an orchestrator-mode sidecar with no review
# blocks, whereas checking a child's commit against a file it never wrote
# would let it through.
RG_VARIANT_RAW="${RG_STATE_VARIANT:-}"
RG_VARIANT="$(printf '%s' "$RG_VARIANT_RAW" | tr -c 'A-Za-z0-9._-' '-' | sed 's/^[.-]*//' | cut -c1-64)"
if [[ -n "$RG_VARIANT" ]]; then
  STATE_FILE=".pi/review-gate-state.${RG_VARIANT}.json"
else
  STATE_FILE=".pi/review-gate-state.json"
fi

# .blocked marker (extension write failure) → fail closed even without JSON.
if [[ -f "${STATE_FILE}.blocked" ]]; then
  echo "[review-gate] gate sidecar write failure detected (.blocked marker) — failing closed." >&2
  echo "[review-gate] Bypass: REVIEW_GATE_BYPASS=1 git commit ..." >&2
  exit 1
fi

# A review snapshot is a disposable worktree the gate itself created: it
# deliberately carries no .pi/ (the extension is inert there), but it shares
# the REAL repo's .git, so a commit/push from it would ship the real repo.
# Fail closed instead of treating the missing sidecar as "extension not
# active in this repo" — the sidecar absence is BY DESIGN here, not a sign
# the gate is off.
case "$(pwd)" in
  */rg-review-snap-*)
    echo "[review-gate] refusing to commit/push from inside a review snapshot worktree (shares the real .git)." >&2
    echo "[review-gate] Bypass: REVIEW_GATE_BYPASS=1 git commit ..." >&2
    exit 1
    ;;
esac

# No sidecar → extension not active in this repo; allow.
[[ -f "$STATE_FILE" ]] || exit 0

command -v node >/dev/null 2>&1 || {
  echo "[review-gate] node not found; cannot verify gate — failing closed." >&2
  echo "[review-gate] Bypass: REVIEW_GATE_BYPASS=1 git commit ..." >&2
  exit 1
}

# The whole verdict chain, in ONE node process. Resolve the checker by
# absolute path (node resolves relative requires against its own cwd, which is
# the repo, not the hook dir).
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CHECK_SCRIPT="${HOOK_DIR}/../scripts/pre-commit-check.cjs"
CHECK_SCRIPT="$(cd "$(dirname "$CHECK_SCRIPT")" && pwd)/$(basename "$CHECK_SCRIPT")"

# Missing checker → FAIL CLOSED (a broken/partial install must be fixed, not
# silently tolerated — same policy the divergence checker itself keeps).
if [[ ! -f "$CHECK_SCRIPT" ]]; then
  echo "[review-gate] pre-commit checker MISSING (${CHECK_SCRIPT}) — failing closed." >&2
  echo "[review-gate] Reinstall the hooks to restore it." >&2
  echo "[review-gate] Bypass: REVIEW_GATE_BYPASS=1 git commit ..." >&2
  exit 1
fi

CHECK_CODE=0
node "$CHECK_SCRIPT" "$STATE_FILE" || CHECK_CODE=$?

# 10 = valid state bypass; 11 = valid USER-chosen advisory mode — both mean
# the commit is allowed; anything else passes the checker's verdict through.
case "$CHECK_CODE" in
  10|11) exit 0 ;;
esac
exit "$CHECK_CODE"
