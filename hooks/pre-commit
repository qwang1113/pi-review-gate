#!/usr/bin/env bash
# pi-review-gate defense-in-depth: verify gate sidecar before commit.
# Validates review/precommit verdicts against current worktree fingerprint.
# Bypass: REVIEW_GATE_BYPASS=1 git commit ...
set -euo pipefail

[[ "${REVIEW_GATE_BYPASS:-}" == "1" ]] && exit 0

STATE_FILE=".pi/review-gate-state.json"

# .blocked marker (extension write failure) → fail closed even without JSON.
if [[ -f "${STATE_FILE}.blocked" ]]; then
  echo "[review-gate] gate sidecar write failure detected (.blocked marker) — failing closed." >&2
  echo "[review-gate] Bypass: REVIEW_GATE_BYPASS=1 git commit ..." >&2
  exit 1
fi

# No sidecar → extension not active in this repo; allow.
[[ -f "$STATE_FILE" ]] || exit 0

command -v node >/dev/null 2>&1 || {
  echo "[review-gate] node not found; cannot verify gate — failing closed." >&2
  exit 1
}

# Validate the complete sidecar shape BEFORE honoring bypass or an advisory
# mode. This keeps every escape path fail-closed for corrupt, unknown-schema,
# or forged states. Exit 10 means a valid bypass; 11 means a valid USER-chosen
# explore/normal advisory state (an agent/auto-classified mode never
# downgrades the hook).
set +e
node - "$STATE_FILE" <<'NODE'
const { readFileSync } = require("node:fs");
let state;
try { state = JSON.parse(readFileSync(process.argv[2], "utf8")); } catch {
  console.error("[review-gate] gate state unreadable — failing closed.");
  process.exit(1);
}
const GATE_VERDICTS = new Set(["PENDING", "READY", "BLOCKED", "NEEDS_HUMAN"]);
const PRECOMMIT_VERDICTS = new Set(["PASS", "FAIL", "NO_CHECKS_RUN", "NOT_RUN"]);
if (state.schema !== 1) {
  console.error("[review-gate] unknown gate schema — failing closed.");
  process.exit(1);
}
const nullableString = (v) => v === null || typeof v === "string";
const validRound = (r) => r && Number.isInteger(r.round) && r.round > 0 &&
  (r.findingsTotal === null || (Number.isInteger(r.findingsTotal) && r.findingsTotal >= 0)) &&
  Array.isArray(r.fingerprints) && r.fingerprints.every((v) => typeof v === "string") &&
  typeof r.at === "string";
if (!nullableString(state.sessionId) ||
    typeof state.hasCodeChange !== "boolean" || typeof state.hasDocChange !== "boolean" ||
    !state.review || !GATE_VERDICTS.has(state.review.verdict) ||
    !nullableString(state.review.fingerprint) || !nullableString(state.review.at) ||
    (state.review.docSync !== undefined && state.review.docSync !== "UPDATED" && state.review.docSync !== "NOT_NEEDED") ||
    !state.precommit || !PRECOMMIT_VERDICTS.has(state.precommit.verdict) ||
    !nullableString(state.precommit.fingerprint) || !nullableString(state.precommit.at) ||
    // Optional lane metadata (fast/full split). A present field must be
    // well-formed — a forged shape means a tampered sidecar, which fails
    // closed like everything else. Absence is fine and is itself fail-closed:
    // a missing testScope cannot claim a full run, so a push stays blocked.
    (state.precommit.mode !== undefined &&
      state.precommit.mode !== "fast" && state.precommit.mode !== "full") ||
    (state.precommit.testScope !== undefined &&
      state.precommit.testScope !== "related" && state.precommit.testScope !== "full" &&
      state.precommit.testScope !== "skipped") ||
    !Array.isArray(state.rounds) || !state.rounds.every(validRound) ||
    !Number.isInteger(state.maxRounds) || state.maxRounds < 3 || state.maxRounds > 50 ||
    !state.bypass || typeof state.bypass.active !== "boolean" ||
    !nullableString(state.bypass.reason) || !nullableString(state.bypass.at) ||
    (state.taskMode !== undefined && state.taskMode !== "loop" && state.taskMode !== "explore" && state.taskMode !== "normal") ||
    (state.taskModeSource !== undefined && state.taskModeSource !== "auto" && state.taskModeSource !== "user") ||
    (state.strategicResetFired !== undefined && typeof state.strategicResetFired !== "boolean") ||
    // Optional agent-requested pause (pause_for_question). It never affects
    // the ship decision, but a present field must be well-formed — a forged
    // shape means a tampered sidecar, which fails closed like everything else.
    (state.pausedQuestion !== undefined &&
      !(state.pausedQuestion && typeof state.pausedQuestion === "object" &&
        typeof state.pausedQuestion.question === "string" &&
        typeof state.pausedQuestion.at === "string")) ||
    // Optional user-granted scope limit (request_scope_limit). It only ever
    // narrows what ARMS the gate (already reflected in hasCodeChange/
    // hasDocChange in this same sidecar); a present field must still be
    // well-formed — a forged shape means a tampered sidecar, which fails
    // closed like everything else.
    (state.scopeLimit !== undefined &&
      !(state.scopeLimit && typeof state.scopeLimit === "object" &&
        Array.isArray(state.scopeLimit.preexistingFiles) &&
        state.scopeLimit.preexistingFiles.every((v) => typeof v === "string") &&
        Array.isArray(state.scopeLimit.sessionFiles) &&
        state.scopeLimit.sessionFiles.every((v) => typeof v === "string") &&
        typeof state.scopeLimit.at === "string")) ||
    // Optional session-edit attribution (scope hints). Never part of the ship
    // decision, but a present field must be well-formed — forged shapes fail
    // closed like everything else.
    (state.sessionEditedFiles !== undefined &&
      !(Array.isArray(state.sessionEditedFiles) &&
        state.sessionEditedFiles.every((v) => typeof v === "string"))) ||
    // Absent = a sidecar written before fingerprint versioning; any present
    // value must be a real version number (a forged non-integer must not slip
    // through and later compare "equal" to the running algorithm).
    (state.fingerprintVersion !== undefined && !Number.isInteger(state.fingerprintVersion)) ||
    typeof state.updatedAt !== "string") {
  console.error("[review-gate] gate state shape/verdict invalid — failing closed.");
  process.exit(1);
}
if (state.bypass.active) process.exit(10);
// SECURITY: only a USER-chosen explore/normal (confirmed dialog or /gate-mode)
// makes the hook advisory. An agent/auto classification must never weaken the
// commit gate.
if ((state.taskMode === "explore" || state.taskMode === "normal") &&
    state.taskModeSource === "user") process.exit(11);
process.exit(0);
NODE
STATE_MODE=$?
set -e
[[ "$STATE_MODE" == "10" || "$STATE_MODE" == "11" ]] && exit 0
[[ "$STATE_MODE" == "0" ]] || exit 1

# Resolve helper scripts relative to the hook location.
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FP_SCRIPT="${HOOK_DIR}/../scripts/compute-fingerprint.cjs"
LABEL_SCRIPT="${HOOK_DIR}/../scripts/scan-test-labels.cjs"

# Test-label English gate (L6). Missing script → warn+skip (NOT fail-closed):
# an older install without this newer script must still be able to commit
# (mirrors the B2 lesson — a new sub-gate must not brick existing installs).
# Present script: a non-zero exit (violation OR internal error) blocks.
if [[ -f "$LABEL_SCRIPT" ]]; then
  node "$LABEL_SCRIPT" "$(pwd)" || {
    echo "[review-gate] Bypass: REVIEW_GATE_BYPASS=1 git commit ..." >&2
    exit 1
  }
else
  echo "[review-gate] test-label scanner not installed (skipping L6) — reinstall hooks to enable." >&2
fi

# Staged/worktree divergence gate (see scripts/check-staged-divergence.cjs for
# the full rationale and the exact safe/unsafe state table). The fingerprint is
# staging-invariant by design, so it cannot notice that `git commit` would ship
# an INDEX that differs from the reviewed worktree; this check closes that gap.
#
# A NUL-safe Node helper does the comparison rather than a shell pipeline: an
# earlier `comm` of two newline-delimited `git diff` lists missed the
# staged-delete + worktree-recreate case entirely (`git diff` does not list
# untracked files) and relied on git's path quoting.
#
# Missing script → FAIL CLOSED (deliberately unlike the L6 scanner above).
#
# L6 is a style gate: skipping it on an older install costs a lint check. This
# checker is different — it is the ONLY guard for a core safety property. The
# fingerprint is intentionally staging-invariant, so it cannot see that the
# INDEX holds content A while the reviewed worktree holds B; skipping this
# check therefore re-opens exactly the fail-open the checker was written to
# close (review binds B, fingerprint matches B, commit publishes A). "Older
# install compatibility" is not a valid reason to fail open on a safety
# invariant, and the install scripts ship this file alongside the hook, so a
# hook that cannot find it is a broken/partial install — which must be fixed,
# not silently tolerated.
DIVERGENCE_SCRIPT="${HOOK_DIR}/../scripts/check-staged-divergence.cjs"
# The second argument is git's own GIT_INDEX_FILE: for `git commit -a` and
# `git commit -- <path>` git stages into a TEMPORARY index and points the hook
# at it, so the plain .git/index is NOT what the commit publishes. Passing it
# explicitly (rather than letting the script read the environment) keeps an
# ambient variable from redirecting the check while still comparing the index
# this commit will really write. Empty when git did not set it.
#
# `--emit-fingerprint` makes this ONE process answer both questions. The
# checker has to materialize the worktree tree anyway; computing the
# fingerprint from that same tree halves the git work AND removes a subtler
# problem: a repository-configured `clean` filter is an arbitrary program, so
# two separate materializations of an UNCHANGED worktree could legitimately
# disagree, leaving the divergence verdict and the fingerprint describing
# different content.
if [[ -f "$DIVERGENCE_SCRIPT" ]]; then
  FP_JSON=$(node "$DIVERGENCE_SCRIPT" "$(pwd)" "${GIT_INDEX_FILE-}" --emit-fingerprint) || {
    echo "[review-gate] Bypass: REVIEW_GATE_BYPASS=1 git commit ..." >&2
    exit 1
  }
else
  echo "[review-gate] staged-divergence checker MISSING (${DIVERGENCE_SCRIPT}) — failing closed." >&2
  echo "[review-gate] This check guards staged-vs-reviewed content; reinstall the hooks to restore it." >&2
  echo "[review-gate] Bypass: REVIEW_GATE_BYPASS=1 git commit ..." >&2
  exit 1
fi

# Fallback for a MIXED install (new hook, older checker that does not know
# --emit-fingerprint and therefore printed nothing): compute the fingerprint
# separately rather than bricking the commit. Correctness is unaffected — only
# the single-materialization property is lost.
if [[ -z "$FP_JSON" ]]; then
  FP_JSON=$(node "$FP_SCRIPT" "$(pwd)") || {
    echo "[review-gate] cannot compute worktree fingerprint — failing closed." >&2
    exit 1
  }
fi

node - "$STATE_FILE" "$FP_JSON" <<'NODE'
const { readFileSync } = require("node:fs");

const statePath = process.argv[2];
const fpJson = process.argv[3];

let state;
try { state = JSON.parse(readFileSync(statePath, "utf8")); } catch {
  console.error("[review-gate] gate state unreadable — failing closed.");
  process.exit(1);
}

// Per-project docSync knob (defense-in-depth mirror of unmetRequirements).
// Default ON; only an explicit `"docSync": false` in a valid config disables.
// Missing/corrupt config ⇒ default (enforced) — fail-safe, never fail-open.
let docSyncEnforced = true;
try {
  const cfg = JSON.parse(readFileSync(".pi/review-gate.json", "utf8"));
  if (cfg && typeof cfg === "object" && cfg.docSync === false) docSyncEnforced = false;
} catch { /* no config — default enforced */ }

// Lane requirement. pre-push re-execs this hook with REVIEW_GATE_REQUIRE_FULL=1
// because publishing needs a precommit run whose tests were not narrowed; a
// plain commit is satisfied by the fast lane. Only the exact string "1" turns
// it on, so an unrelated ambient value cannot silently relax OR tighten it.
const requireFullTests = process.env.REVIEW_GATE_REQUIRE_FULL === "1";

if (state.schema !== 1) {
  console.error("[review-gate] unknown gate schema — failing closed.");
  process.exit(1);
}

// P0/P1: reject malformed schema=1 payloads, AND unknown/forged verdict enums.
// A payload with precommit.verdict:"READY" (not a real precommit verdict) must
// be rejected here so it can't slip past the if-else chain below and fail-open.
const GATE_VERDICTS = new Set(["PENDING", "READY", "BLOCKED", "NEEDS_HUMAN"]);
const PRECOMMIT_VERDICTS = new Set(["PASS", "FAIL", "NO_CHECKS_RUN", "NOT_RUN"]);
if (typeof state.hasCodeChange !== "boolean" || typeof state.hasDocChange !== "boolean" ||
    !state.review || !GATE_VERDICTS.has(state.review.verdict) ||
    !state.precommit || !PRECOMMIT_VERDICTS.has(state.precommit.verdict) ||
    !Array.isArray(state.rounds) ||
    !state.bypass || typeof state.bypass.active !== "boolean") {
  console.error("[review-gate] gate state shape/verdict invalid — failing closed.");
  process.exit(1);
}

if (state.bypass && state.bypass.active) process.exit(0);
if (!state.hasCodeChange && !state.hasDocChange) process.exit(0);

let currentFp;
let runningVersion;
try {
  const fp = JSON.parse(fpJson);
  if (fp.unavailable) throw new Error("fingerprint unavailable");
  currentFp = fp.digest;
  runningVersion = fp.version;
} catch {
  console.error("[review-gate] cannot compute worktree fingerprint — failing closed.");
  process.exit(1);
}

// FINGERPRINT ALGORITHM MIGRATION.
//
// A digest is only meaningful under the algorithm that produced it. Because a
// Pi extension is a RESIDENT process that loads its modules once, right after
// an upgrade the extension still writes bindings from the OLD algorithm while
// this hook already runs the NEW one — so the hook rejected the very commit
// the gate had just approved, reporting "code was modified after the last
// READY review" even though the worktree was byte-identical. Detect that
// explicitly and say what to do, instead of blaming the code. Still
// fail-closed: an unverifiable binding never ships.
const bindingVersion = state.fingerprintVersion;
if ((state.hasCodeChange || state.hasDocChange) &&
    Number.isInteger(runningVersion) && bindingVersion !== runningVersion) {
  const boundTo = bindingVersion === undefined ? "an unversioned (pre-migration)" : `a v${bindingVersion}`;
  console.error(
    `[review-gate] fingerprint algorithm mismatch: the gate state carries ${boundTo} binding, ` +
    `this hook computes v${runningVersion}. The code was NOT modified — the binding simply cannot ` +
    "be verified under the current algorithm.");
  console.error("[review-gate] To clear it: (1) restart Pi (or /reload) so the extension picks up the " +
    "new algorithm, (2) run the precommit runner again, (3) get a fresh READY review.");
  console.error("[review-gate] Bypass: REVIEW_GATE_BYPASS=1 git commit ...");
  process.exit(1);
}

const problems = [];

if (state.hasCodeChange) {
  if (state.review.verdict !== "READY") {
    problems.push(`review is ${state.review.verdict}`);
  } else if (!state.review.fingerprint) {
    problems.push("review PASS has no fingerprint binding — cannot verify");
  } else if (state.review.fingerprint !== currentFp) {
    problems.push("code was modified after the last READY review (fingerprint mismatch)");
  } else if (docSyncEnforced &&
             state.review.docSync !== "UPDATED" && state.review.docSync !== "NOT_NEEDED") {
    // docSync knob: the READY review must carry a code↔doc attestation.
    problems.push("docSync enforced: READY review lacks a code↔doc attestation (UPDATED | NOT_NEEDED)");
  }

  // Fail-closed: only an explicit PASS bound to the current fingerprint passes.
  if (state.precommit.verdict === "PASS") {
    if (!state.precommit.fingerprint) {
      problems.push("precommit PASS has no fingerprint binding — cannot verify");
    } else if (state.precommit.fingerprint !== currentFp) {
      problems.push("code was modified after the last precommit PASS (fingerprint mismatch)");
    } else if (requireFullTests && state.precommit.testScope !== "full") {
      // Lane split, mirroring lib/constants.ts requiresFullPrecommit and the
      // extension's L1 check: a commit accepts the fast lane, a PUSH does not.
      // An absent testScope predates the split and cannot claim a full run.
      const covered = state.precommit.testScope || "unknown (sidecar predates the fast/full split)";
      problems.push(
        `push requires a FULL precommit run (tests covered: ${covered}) — ` +
        'the fast lane only runs the tests related to the changed files; re-run with mode "full"');
    }
  } else if (state.precommit.verdict === "NOT_RUN") {
    problems.push("precommit not run");
  } else if (state.precommit.verdict === "FAIL") {
    problems.push("precommit FAILED");
  } else if (state.precommit.verdict === "NO_CHECKS_RUN") {
    problems.push("precommit ran zero checks (not a pass)");
  } else {
    problems.push(`precommit verdict unrecognized (${String(state.precommit.verdict)})`);
  }
} else if (state.hasDocChange) {
  if (state.review.verdict !== "READY") {
    problems.push(`doc review is ${state.review.verdict}`);
  } else if (!state.review.fingerprint) {
    problems.push("doc review PASS has no fingerprint binding");
  } else if (state.review.fingerprint !== currentFp) {
    problems.push("docs were modified after the last READY review (fingerprint mismatch)");
  }
}

if (problems.length) {
  console.error("[review-gate] commit blocked:");
  for (const p of problems) console.error(`  - ${p}`);
  console.error("[review-gate] Bypass: REVIEW_GATE_BYPASS=1 git commit ...");
  process.exit(1);
}
NODE
